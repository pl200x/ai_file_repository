<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.file_management.mapper.TenantMapper">
    <resultMap id="TenantResultMap" type="com.example.file_management.entity.Tenant">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="time" column="created_at"/>
    </resultMap>

    <select id="queryById" resultMap="TenantResultMap">
        SELECT * FROM tenants WHERE id = #{id}
    </select>

    <insert id="addTenant">
        INSERT INTO tenants (name) VALUES (#{name})
    </insert>
</mapper>